PORT=3002

# Dominio público del VPS
PUBLIC_URL=https://embair.es
BASE_URL=https://embair.es

# Credenciales Admin (configura una clave exclusiva de al menos 12 caracteres)
ADMIN_USER=
ADMIN_PASS=
ADMIN_PASS_HASH=

# Clave persistente para firmar sesiones del portal mayorista
# Genera una sola vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_TOKEN_SECRET=

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram / Bots (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Portal Clientes (opcional)
PORTAL_TEST_EMAIL=
PORTAL_TEST_PASSWORD=
