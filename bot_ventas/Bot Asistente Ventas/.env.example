# Configuración de Conexión con el Sistema Central (App Web)
# -----------------------------------------------------------
# Si el bot corre en la misma máquina que la web, usar 'localhost'
# Si la web está en un VPS y el bot en tu PC, pon el dominio del VPS
API_HOST=localhost
API_PORT=3002
API_PROTOCOL=http

# Configuración Pública (Para generar links)
# Si estás en VPS, pon tu dominio (ej: mi-tienda.com)
PUBLIC_HOST=localhost
PUBLIC_URL=http://localhost:3002

# Credenciales de MercadoLibre (Si aplica)
ML_USER=tu_usuario
ML_PASS=tu_contrasena

# API Keys (Si aplica)
OPENAI_API_KEY=sk-proj-xxxx